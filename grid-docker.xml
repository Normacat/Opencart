<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Master Suite" thread-count="5">

<groups>
	<run>
		<include name="Master" />
		<include name="Regression"/> 
		<include name="Sanity"></include>
	</run>
</groups>

	<listeners>
		<listener class-name="utilities.ExtentReportManager"></listener>
	</listeners>
	
<test name="Linux-Chrome">
<parameter name="os" value="Linux"></parameter>
<parameter name="browser" value="chrome"></parameter>
  
	<classes>
		  <class name="testCases.TC001_LoginTest" />  
		  <class name="testCases.TC002_LoginTestWithInvalidCredentials"/> 
		 <class name="testCases.TC003_ValidatingUserProfile"/> 
		 <class name="testCases.TC004_LoginDDT" /> 
		 <class name="testCases.TC005_LoginWithInvalidUserName"/> 
		<class name="testCases.TC006_LoginWithInvalidPassword"/>
	</classes>
  </test> <!-- Test -->
  
  
  <test name="Linux-Edge">
<parameter name="os" value="Linux"></parameter>
<parameter name="browser" value="firefox"></parameter>
  
	<classes>
		<class name="testCases.TC001_LoginTest" /> 
		<class name="testCases.TC002_LoginTestWithInvalidCredentials"/>
		<class name="testCases.TC003_ValidatingUserProfile"/> 
		<class name="testCases.TC004_LoginDDT" /> 
		 <class name="testCases.TC005_LoginWithInvalidUserName"/> 
		<class name="testCases.TC006_LoginWithInvalidPassword"/>


	</classes>
  </test> <!-- Test -->
  
  
</suite> <!-- Suite -->
